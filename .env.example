# Ambiente (development/production)
ENV=development

# Logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
MAX_LOG_SIZE_MB=10

# Processamento
MAX_REGISTROS=0
MAX_LINHAS_BUSCA_CABECALHO=10

# Relatório
RELATORIO_NOME_PADRAO=relatorio_comparacao.xlsx
RELATORIO_INCLUIR_IGUAIS=true
RELATORIO_INCLUIR_ERROS=true

# Pastas (relativo ao projeto)
LOGS_DIR=./logs
REPORTS_DIR=./relatorios

# Segurança
HASH_SALT=your-secret-salt-here